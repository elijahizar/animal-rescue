---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Aider';
const description =
	'Actions concrètes au quotidien pour protéger les espèces menacées et liste des organismes engagés.';

const quotidien = [
	{
		icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>',
		titre: 'Consommation responsable',
		actions: [
			'Privilégier le poisson certifié durable (MSC, ASC) et varier les espèces consommées.',
			'Refuser les produits issus d’espèces protégées : ivoire, ailerons de requin, corne de rhinocéros, peaux exotiques.',
			'Choisir du bois et du papier certifiés FSC pour freiner la déforestation.',
		],
	},
	{
		icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7a3 3 0 0 0 6 0V2"/><path d="M3 2h6"/><path d="M6 9v13"/><path d="M15 2h2a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3h-2"/><path d="M16 12v11"/></svg>',
		titre: 'Alimentation',
		actions: [
			'Réduire la part de viande et préférer des filières locales et extensives.',
			'Éviter l’huile de palme non certifiée, responsable de la déforestation chez le tigre et l’orang-outan.',
			'Limiter les produits suremballés et le plastique à usage unique.',
		],
	},
	{
		icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>',
		titre: 'Transport & énergie',
		actions: [
			'Privilégier les transports partagés, les mobilités douces et l’efficacité énergétique.',
			'Réduire son empreinte carbone : chaque tonne de CO₂ accélère le réchauffement qui frappe coraux, ours et baleines.',
		],
	},
	{
		icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>',
		titre: 'Environnement proche',
		actions: [
			'Favoriser la biodiversité dans son jardin ou son balcon : plantes locales, nichoirs, pas de pesticides.',
			'Réduire la pollution plastique et chimique qui termine dans les rivières puis les océans.',
		],
	},
];

const organisations = [
	{
		name: 'WWF France',
		description: 'Conservation de la nature, espèces et grands écosystèmes.',
		url: 'https://www.wwf.fr/',
	},
	{
		name: 'Greenpeace France',
		description: 'Campagnes pour le climat, les océans et les forêts.',
		url: 'https://www.greenpeace.fr/',
	},
	{
		name: 'LPO (Ligue pour la Protection des Oiseaux)',
		description: 'Protection des oiseaux sauvages et de la biodiversité.',
		url: 'https://www.lpo.fr/',
	},
	{
		name: 'Sea Shepherd France',
		description: 'Lutte contre la pêche illégale et le braconnage marin.',
		url: 'https://www.seashepherd.fr/',
	},
	{
		name: 'Fondation Nicolas Hulot',
		description: 'Sensibilisation et actions pour la transition écologique',
		url: 'https://www.fondation-nicolas-hulot.org/',
	},
	{
		name: "Comité français de l'UICN",
		description: 'Expertise scientifique et actions de protection des espèces.',
		url: 'https://uicn.fr/',
	},
];
---

<BaseLayout title={title} description={description}>
	<header class="page-hero">
		<div class="container">
			<h1>Comment aider</h1>
			<p class="subtitle">
				Chaque geste compte. Voici des actions concrètes au quotidien et les
				organismes qui œuvrent sur le terrain pour les espèces menacées.
			</p>
		</div>
	</header>

	<section class="container section">
		<h2>Agir au quotidien</h2>
		<p class="lead">
			La déforestation, le braconnage, la pollution et le changement climatique
			sont nourris par nos choix de tous les jours. Ces quatre leviers sont les
			plus efficaces pour renverser la tendance.
		</p>

		<div class="grid">
			{quotidien.map((item) => (
				<article class="card">
					<div class="card-head">
						<span class="card-icon" set:html={item.icon} />
						<h3>{item.titre}</h3>
					</div>
					<ul class="card-list">
						{item.actions.map((a) => (
							<li>{a}</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>

	<section class="container section">
		<h2>Suivre et soutenir les organismes engagés</h2>
		<p class="lead-muted">
			Ces organismes français et internationaux agissent pour les espèces
			menacées. Découvrez leurs missions et leurs recommandations.
		</p>
		<div class="orgs">
			{organisations.map((org) => (
				<a class="org" href={org.url} target="_blank" rel="noopener noreferrer">
					<span class="org-name">{org.name}</span>
					<span class="org-desc">{org.description}</span>
					<span class="org-arrow" aria-hidden="true">→</span>
				</a>
			))}
		</div>
	</section>

	<section class="container section">
		<h2>Faire passer le message</h2>
		<p>
			Parlez d’Animal Rescue et des espèces menacées dans votre entourage.
			La sensibilisation est la première ligne de défense : on protège ce que
			l’on connaît et que l’on aime.
		</p>
		<a class="button" href="/fr/aide/">Découvrir les espèces</a>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: var(--space-12) 0 var(--space-16);
		background: linear-gradient(
			145deg,
			var(--color-forest) 0%,
			var(--color-forest-dark) 100%
		);
		color: var(--color-cream);
	}

	.page-hero h1 {
		color: var(--color-white);
	}

	.subtitle {
		font-size: var(--font-size-xl);
		max-width: 42rem;
		color: var(--color-cream);
		opacity: 0.95;
	}

	.section {
		padding: var(--space-12) 0;
	}

	.section h2 {
		margin-bottom: var(--space-4);
	}

	.lead,
	.lead-muted {
		font-size: var(--font-size-lg);
		max-width: 46rem;
		margin-bottom: var(--space-8);
	}

	.lead-muted {
		color: var(--color-muted);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-6);
	}

	.card {
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-6);
		box-shadow: var(--shadow-sm);
	}

	.card-head {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
	}

	.card-icon {
		color: var(--color-orange);
		display: flex;
	}

	.card-list {
		margin: 0;
		padding-left: var(--space-4);
	}

	.card-list li {
		margin-bottom: var(--space-3);
	}

	.orgs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--space-6);
	}

	.org {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-6);
		box-shadow: var(--shadow-sm);
		color: var(--color-ink);
		text-decoration: none;
		transition:
			transform 0.15s,
			box-shadow 0.15s;
	}

	.org:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		text-decoration: none;
		color: var(--color-ink);
	}

	.org-name {
		font-weight: 700;
		color: var(--color-forest-dark);
	}

	.org-desc {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.org-arrow {
		margin-top: var(--space-2);
		color: var(--color-orange);
		font-weight: 700;
	}

	@media (max-width: 720px) {
		.page-hero {
			padding-bottom: var(--space-12);
		}
	}
</style>