---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, excerpt, newsTagLabel } from '../../lib/news';
import { commonsSrcset } from '../../lib/urls';
import { IUCN_STATUS } from '../../lib/iucn';

const animals = await getCollection('animals');
const news = await getCollection('news');
news.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

const featured = animals.slice(0, 3);
const latestNews = news.slice(0, 3);
const hero = animals.find((a) => a.data.slug === 'tigre')?.data.gallery[0];

const title = 'Accueil';
const description =
	'Aidons les animaux en danger d’extinction : fiches espèces, carte interactive, actualités et actions concrètes.';
---

<BaseLayout title={title} description={description}>
	<section class="hero">
		<img
			class="hero-media"
			src={hero?.src}
			srcset={commonsSrcset(hero?.src ?? '', [500, 960, 1280])}
			sizes="100vw"
			alt={hero?.alt ?? 'Tigre du Bengale'}
			width="1280"
			height="853"
			fetchpriority="high"
		/>
		<div class="hero-content">
			<div class="container">
				<h1 class="hero-title">Aidons les animaux en danger d'extinction</h1>
				<p class="hero-subtitle">
					Découvrez les espèces menacées, comprenez les causes de leur déclin et
					agissez concrètement pour les protéger.
				</p>
				<a class="button" href={getRelativeLocaleUrl('fr', 'aide')}>Voir les espèces</a>
			</div>
		</div>
		{hero && (
			<p class="hero-credit">
				Photo : {hero.author}
				<a href={hero.page} rel="noopener">Wikimedia Commons</a>
				· {hero.licence}
			</p>
		)}
	</section>

	<div class="container">
		<section class="section">
			<div class="section-head">
				<h2>Espèces à la une</h2>
				<a href={getRelativeLocaleUrl('fr', 'aide')}>Toutes les espèces →</a>
			</div>
			<div class="cards">
				{featured.map((animal) => {
					const status = IUCN_STATUS[animal.data.iucnStatus];
					return (
						<a
							class="card"
							href={getRelativeLocaleUrl('fr', `aide/${animal.data.slug}`)}
						>
							<img
								class="card-img"
								src={animal.data.gallery[0]?.src}
								srcset={commonsSrcset(animal.data.gallery[0]?.src ?? '')}
								alt={animal.data.gallery[0]?.alt ?? animal.data.name}
								loading="lazy"
								width="1280"
							/>
							<div class="card-body">
								<div class="card-head">
									<h3>{animal.data.name}</h3>
									<span class="status" style={`background: ${status.color};`}>
										{animal.data.iucnStatus}
									</span>
								</div>
								<p class="card-sci">{animal.data.scientificName}</p>
							</div>
						</a>
					);
				})}
			</div>
		</section>

		<section class="section">
			<div class="section-head">
				<h2>Dernières actualités</h2>
				<a href={getRelativeLocaleUrl('fr', 'infos')}>Toutes les actualités →</a>
			</div>
			<div class="news-list">
				{latestNews.map((entry) => (
					<article class="news-item">
						<p class="news-meta">
							<span class="tag">{newsTagLabel(entry.data.animal)}</span>
							<span>· {formatDate(entry.data.date)} · {entry.data.source}</span>
						</p>
						<a
							class="news-title"
							href={getRelativeLocaleUrl('fr', `infos/${entry.id}`)}
						>
							{entry.data.title}
						</a>
						<p class="news-excerpt">{excerpt(entry.body, 160)}</p>
					</article>
				))}
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.section {
		padding: var(--space-12) 0;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-6);
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--space-6);
	}

	.card {
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		color: var(--color-ink);
		text-decoration: none;
		transition:
			transform 0.15s,
			box-shadow 0.15s;
	}

	.card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		text-decoration: none;
		color: var(--color-ink);
	}

	.card-img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.card-body {
		padding: var(--space-4) var(--space-6) var(--space-6);
	}

	.card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}

	.status {
		color: #fff;
		font-weight: 700;
		font-size: var(--font-size-sm);
		padding: 0.15rem 0.6rem;
		border-radius: var(--radius-full);
	}

	.card-sci {
		font-style: italic;
		color: var(--color-muted);
		margin: 0.25rem 0 0;
	}

	.news-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--space-6);
	}

	.news-item {
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-6);
		box-shadow: var(--shadow-sm);
	}

	.news-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		margin: 0 0 var(--space-3);
	}

	.tag {
		background: var(--color-forest-light);
		color: #fff;
		padding: 0.2rem 0.7rem;
		border-radius: var(--radius-full);
		font-weight: 600;
		font-size: var(--font-size-sm);
	}

	.news-title {
		font-weight: 700;
		color: var(--color-forest-dark);
		line-height: 1.3;
	}

	.news-title:hover {
		color: var(--color-forest);
	}

	.news-excerpt {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		margin: var(--space-2) 0 0;
	}

	@media (max-width: 720px) {
		.section-head {
			flex-direction: column;
			gap: var(--space-2);
		}
	}
</style>