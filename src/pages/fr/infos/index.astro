---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate, excerpt, newsTagLabel } from '../../../lib/news';

const news = await getCollection('news');
news.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));

const PER_PAGE = 10;
const totalPages = Math.max(1, Math.ceil(news.length / PER_PAGE));
const pageNews = news.slice(0, PER_PAGE);

const tags = [...new Set(news.map((entry) => entry.data.animal))].sort(
	(a, b) => newsTagLabel(a).localeCompare(newsTagLabel(b), 'fr'),
);

const title = 'Actualités';
const description =
	'Les dernières nouvelles sur les espèces menacées, en langue française, à partir de flux RSS vérifiés.';
---

<BaseLayout title={title} description={description}>
	<div class="container page">
		<header class="page-head">
			<h1>Actualités</h1>
			<p class="text-muted">
				Les dernières nouvelles sur les espèces menacées, en langue française,
				à partir de flux RSS vérifiés, actualisées quotidiennement.
			</p>
		</header>

		<nav class="tags" aria-label="Filtrer par espèce">
			<span class="tags-label">Filtrer :</span>
			{tags.map((tag) => (
				<a class="tag" href={getRelativeLocaleUrl('fr', `infos/tag/${tag}`)}>
					{newsTagLabel(tag)}
				</a>
			))}
		</nav>

		<ol class="news-list">
			{pageNews.map((entry) => (
				<li class="news-item">
					<a class="news-title" href={getRelativeLocaleUrl('fr', `infos/${entry.id}`)}>
						{entry.data.title}
					</a>
					<p class="news-meta">
						<a class="tag" href={getRelativeLocaleUrl('fr', `infos/tag/${entry.data.animal}`)}>
							{newsTagLabel(entry.data.animal)}
						</a>
						<span>· {formatDate(entry.data.date)} · {entry.data.source}</span>
					</p>
					<p class="news-excerpt">{excerpt(entry.body)}</p>
				</li>
			))}
		</ol>

		{totalPages > 1 && (
			<nav class="pagination">
				<a href={getRelativeLocaleUrl('fr', 'infos/page/2')}>Suivante →</a>
			</nav>
		)}
	</div>
</BaseLayout>

<style>
	.page {
		padding: var(--space-12) 0 var(--space-16);
		max-width: 46rem;
	}

	.page-head h1 {
		margin-bottom: var(--space-2);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: var(--space-6);
	}

	.tags-label {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.tag {
		background: var(--color-forest-light);
		color: #fff;
		padding: 0.2rem 0.7rem;
		border-radius: var(--radius-full);
		font-weight: 600;
		font-size: var(--font-size-sm);
		text-decoration: none;
	}

	.tag:hover {
		background: var(--color-forest-dark);
		color: #fff;
	}

	.news-list {
		list-style: none;
		margin: var(--space-8) 0 0;
		padding: 0;
	}

	.news-item {
		padding: var(--space-6) 0;
		border-top: 1px solid var(--color-border);
	}

	.news-item:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.news-title {
		font-size: var(--font-size-xl);
		font-weight: 700;
		color: var(--color-forest-dark);
		text-decoration: none;
		line-height: 1.25;
	}

	.news-title:hover {
		color: var(--color-forest);
		text-decoration: underline;
	}

	.news-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		margin: var(--space-2) 0;
	}

	.news-excerpt {
		color: var(--color-muted);
		margin: 0;
	}

	.pagination {
		margin-top: var(--space-8);
		font-weight: 600;
	}

	@media (max-width: 720px) {
		.page {
			padding-left: var(--space-8);
			padding-right: var(--space-8);
		}
	}
</style>