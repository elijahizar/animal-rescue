---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { formatDate, excerpt, newsTagLabel } from '../../../../lib/news';

export async function getStaticPaths() {
	const news = await getCollection('news');
	const tags = [...new Set(news.map((entry) => entry.data.animal))];
	return tags.map((tag) => ({
		params: { tag },
		props: { tag, entries: news.filter((entry) => entry.data.animal === tag) },
	}));
}

interface Props {
	tag: string;
	entries: Awaited<ReturnType<typeof getCollection<'news'>>>[number][];
}

const { tag, entries } = Astro.props;
const label = newsTagLabel(tag);
const ordered = [...entries].sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
---

<BaseLayout title={`Actualités — ${label}`}>
	<div class="container page">
		<nav class="breadcrumb">
			<a href={getRelativeLocaleUrl('fr', 'infos')}>← Toutes les actualités</a>
		</nav>

		<header class="page-head">
			<h1>{label}</h1>
			<p class="text-muted">
				{ordered.length} actualité{ordered.length > 1 ? 's' : ''} sur {label}.
			</p>
		</header>

		<ol class="news-list">
			{ordered.map((entry) => (
				<li class="news-item">
					<a class="news-title" href={getRelativeLocaleUrl('fr', `infos/${entry.id}`)}>
						{entry.data.title}
					</a>
					<p class="news-meta">
						<span>· {formatDate(entry.data.date)} · {entry.data.source}</span>
					</p>
					<p class="news-excerpt">{excerpt(entry.body)}</p>
				</li>
			))}
		</ol>
	</div>
</BaseLayout>

<style>
	.page {
		padding: var(--space-12) 0 var(--space-16);
		max-width: 46rem;
	}

	.breadcrumb {
		margin-bottom: var(--space-6);
		font-weight: 600;
	}

	.page-head h1 {
		margin-bottom: var(--space-2);
	}

	.news-list {
		list-style: none;
		margin: var(--space-8) 0 0;
		padding: 0;
	}

	.news-item {
		padding: var(--space-6) 0;
		border-top: 1px solid var(--color-border);
	}

	.news-item:last-child {
		border-bottom: 1px solid var(--color-border);
	}

	.news-title {
		font-size: var(--font-size-xl);
		font-weight: 700;
		color: var(--color-forest-dark);
		text-decoration: none;
		line-height: 1.25;
	}

	.news-title:hover {
		color: var(--color-forest);
		text-decoration: underline;
	}

	.news-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		margin: var(--space-2) 0;
	}

	.news-excerpt {
		color: var(--color-muted);
		margin: 0;
	}

	@media (max-width: 720px) {
		.page {
			padding-left: var(--space-8);
			padding-right: var(--space-8);
		}
	}
</style>