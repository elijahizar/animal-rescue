---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimalList from '../../components/AnimalList.tsx';
import type { AnimalListItem } from '../../components/AnimalList.tsx';

const locale = 'fr';
const animals = await getCollection('animals');
const regions = await getCollection('regions');

const listItems: AnimalListItem[] = animals.map((animal) => ({
	slug: animal.data.slug,
	name: animal.data.name,
	scientificName: animal.data.scientificName,
	iucnStatus: animal.data.iucnStatus,
	causes: animal.data.causes,
	continents: regions
		.filter((region) => animal.data.regions.includes(region.data.id))
		.map((region) => region.data.continent),
	image: animal.data.gallery[0]?.src,
}));
---

<BaseLayout title="Aide">
	<div class="container">
		<h1>Les espèces à protéger</h1>
		<p class="text-muted">
			Filtrez par cause, statut IUCN ou continent, ou recherchez par nom.
		</p>

		<AnimalList
			animals={listItems}
			baseUrl={getRelativeLocaleUrl(locale, 'aide')}
			client:load
		/>
	</div>
</BaseLayout>

<style>
	.animal-list :global(.filters) {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-block: 1.5rem 2rem;
		background: #ffffff;
		padding: 1.25rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-sm);
	}

	.animal-list :global(.search-input) {
		width: 100%;
		padding: 0.7rem 1rem;
		font-size: var(--font-size-md);
		border: 2px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-cream);
	}

	.animal-list :global(.filter-group) {
		border: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}

	.animal-list :global(.filter-group legend) {
		font-weight: 700;
		color: var(--color-forest-dark);
		padding-right: 0.5rem;
	}

	.animal-list :global(.chip) {
		border: 2px solid var(--color-border);
		background: #ffffff;
		border-radius: var(--radius-full);
		padding: 0.35rem 0.85rem;
		font-size: var(--font-size-sm);
		font-weight: 600;
		cursor: pointer;
		color: var(--color-ink);
	}

	.animal-list :global(.chip-active) {
		background: var(--color-forest);
		border-color: var(--color-forest);
		color: #ffffff;
	}

	.animal-list :global(.cards) {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	.animal-list :global(.card) {
		background: #ffffff;
		border-radius: var(--radius-md);
		overflow: hidden;
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-sm);
		transition:
			transform 0.15s,
			box-shadow 0.15s;
		text-decoration: none;
		color: inherit;
	}

	.animal-list :global(.card:hover) {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
		text-decoration: none;
	}

	.animal-list :global(.card img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.animal-list :global(.card-body) {
		padding: 1rem;
	}

	.animal-list :global(.card-title-row) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.animal-list :global(.card h3) {
		font-size: var(--font-size-lg);
	}

	.animal-list :global(.status-badge) {
		color: #ffffff;
		font-weight: 800;
		font-size: var(--font-size-sm);
		border-radius: var(--radius-full);
		padding: 0.15rem 0.6rem;
		white-space: nowrap;
	}

	.animal-list :global(.card-scientific) {
		font-style: italic;
		color: var(--color-muted);
		margin: 0.25rem 0 0;
	}

	.animal-list :global(.card-continents) {
		margin: 0.6rem 0 0;
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-forest);
	}

	.animal-list :global(.empty) {
		color: var(--color-muted);
		padding: 2rem 0;
	}
</style>
