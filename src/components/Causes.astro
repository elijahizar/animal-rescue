---
import { CAUSES } from '../lib/causes';
import type { CauseId } from '../lib/causes';

interface Props {
	causes: CauseId[];
}

const { causes } = Astro.props;

const icons: Record<CauseId, string> = {
	deforestation:
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V8"/><path d="M12 8c-3.5 0-6-2.5-6-6 3.5 0 6 2.5 6 6z"/><path d="M12 14c-3 0-5-2-5-5 3 0 5 2 5 5z"/><path d="M12 19c2.5 0 4.5-1.5 4.5-4 2 0 3.5 1.5 3.5 4z"/></svg>',
	braconnage:
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="0.8" fill="currentColor"/></svg>',
	pollution:
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h18"/><path d="M6 17a4 4 0 0 1 8 0"/><path d="M10 13a4 4 0 0 1 6-1.6"/><path d="M14 10a4 4 0 0 1 3-1"/></svg>',
	'changement-climatique':
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
	'perte-habitat':
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12 12 4l9 8"/><path d="M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></svg>',
	surpeche:
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8c6-4 14-4 20 0-6 4-14 4-20 0z"/><path d="M5 8v8"/><path d="M19 8v8"/><path d="M5 16c3 2 5 2 8 0"/></svg>',
	'especes-invasives':
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 4v10l-7 4-7-4V7z"/><path d="M12 9v6M9 12h6"/></svg>',
	'trafic-especes':
		'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9h12v12H6z"/><path d="M6 12a3 3 0 0 1-3 3v3a3 3 0 0 1 3 3"/><path d="M18 12a3 3 0 0 0 3 3v3a3 3 0 0 0-3 3"/><path d="M12 9V6a2 2 0 1 1 4 0v2"/></svg>',
};
---

<div class="causes">
	{
		causes.map((id) => {
			const cause = CAUSES[id];
			return (
				<span class="cause-chip" style={`border-color: ${cause.color}; color: ${cause.color};`}>
					<span class="cause-icon" set:html={icons[id]} />
					{cause.label}
				</span>
			);
		})
	}
</div>

<style>
	.causes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.cause-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border: 2px solid;
		border-radius: 999px;
		padding: 0.4rem 0.9rem;
		font-weight: 600;
		font-size: 0.9rem;
		background: #ffffff;
	}

	.cause-icon {
		display: inline-flex;
	}
</style>
